{% extends 'base.html.twig' %}
{% block body %}
<h1>Contactos</h1>
<h2>Bienvenido a la web de contactos.</h2>
<p>Página de inicio</p>

{% if app.user %}
    <p><a href="{{ path('nuevo') }}">Añadir contacto</a></p>
{% endif %}

{% for contacto in contactos %}
    {{ include ('partials/_contacto.html.twig', {'contacto': contacto})}}
{% endfor %}
{% endblock %}